{
  "name": "@local/codex-skin",
  "version": "1.0.0",
  "private": true,
  "description": "Codex Neural Skin for DeepSeek Harness: mint glass UI over a live transformer + CNN data-flow background.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-theme"] }
  }
}
